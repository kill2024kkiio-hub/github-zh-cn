{
  "manifest_version": 3,
  "name": "GitHub 汉化 · 中文化翻译",
  "short_name": "GitHub 汉化",
  "version": "1.2.0",
  "description": "把 GitHub 界面汉化为简体中文：内置 UI 词典即时翻译菜单/按钮/状态，可选全文翻译 README、Issue、PR 正文。",
  "minimum_chrome_version": "102",
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": [
    "https://github.com/*",
    "https://gist.github.com/*",
    "https://translate.googleapis.com/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "https://api.cognitive.microsofttranslator.com/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "GitHub 汉化",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*", "https://gist.github.com/*"],
      "js": ["src/dictionary.js", "src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
